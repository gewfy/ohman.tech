---
interface Props {
  provider: 'youtube' | 'vimeo';
  id: string;
  title: string;
}

const { provider, id, title } = Astro.props;

/* The player sits in the page as itself; browsers hold the request back until
   the frame is near the viewport. */
const embed =
  provider === 'youtube'
    ? `https://www.youtube-nocookie.com/embed/${id}?rel=0&modestbranding=1`
    : `https://player.vimeo.com/video/${id}?title=0&byline=0&portrait=0&dnt=1`;
---

<figure class="film">
  <div class="film__frame">
    <iframe
      src={embed}
      title={title}
      loading="lazy"
      allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media"
      allowfullscreen
    ></iframe>
  </div>
</figure>

<style>
  .film {
    max-width: var(--maxw);
    margin: 0 auto var(--tile-gap);
    padding: 0 var(--gut);
  }

  .film__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg-2);
  }

  .film__frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
