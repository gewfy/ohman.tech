---
export type FilmLayout = 'tall' | 'wide' | 'half' | 'full';

export interface FilmData {
  provider: 'youtube' | 'vimeo';
  id: string;
  title: string;
  layout?: FilmLayout;
}

interface Props extends FilmData {
  /** When set, this is a gallery tile rather than a lone block. */
  variant?: FilmLayout;
}

const { provider, id, title, layout = 'full', variant } = Astro.props;
const tile = variant ?? layout;

const src =
  provider === 'youtube'
    ? `https://www.youtube-nocookie.com/embed/${id}?rel=0&modestbranding=1&playsinline=1&enablejsapi=1`
    : `https://player.vimeo.com/video/${id}?title=0&byline=0&portrait=0&dnt=1&playsinline=1`;
---

<div
  class="film-tile"
  data-ar={tile === 'tall' || tile === 'half' ? undefined : tile}
  data-provider={provider}
  data-id={id}
  data-title={title}
>
  <div class="film-tile__frame">
    <iframe
      src={src}
      title={title}
      loading="lazy"
      allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media"
      allowfullscreen
    ></iframe>
  </div>
</div>
