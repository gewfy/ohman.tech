---
/**
 * Full-screen viewer shared by every gallery tile and the lead photograph.
 * Markup only — gallery.js does the work.
 */
---

<div
  class="viewer"
  id="viewer"
  role="dialog"
  aria-modal="true"
  aria-label="Gallery viewer"
  hidden
>
  <div class="viewer__stage">
    <img class="viewer__img" alt="" />
    <div class="viewer__film" hidden>
      <iframe
        title=""
        allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media"
        allowfullscreen
      ></iframe>
    </div>
  </div>

  <img
    class="viewer__mark"
    src="/logo/lockup-white-s.svg"
    alt=""
    width="473"
    height="473"
    aria-hidden="true"
  />

  <p class="viewer__caption"></p>
  <p class="viewer__count label"></p>

  <button class="viewer__btn viewer__close" type="button" aria-label="Close">
    ✕
  </button>
  <button class="viewer__btn viewer__prev" type="button" aria-label="Previous">
    ←
  </button>
  <button class="viewer__btn viewer__next" type="button" aria-label="Next">
    →
  </button>
</div>

<script>
  import '../scripts/gallery.js';
</script>
