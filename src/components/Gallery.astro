---
import Shot from './Shot.astro';
import Video from './Video.astro';
import type { ShotData } from './Shot.astro';
import type { FilmData } from './Video.astro';

export type GalleryItem = ShotData | FilmData;

interface Props {
  items: GalleryItem[];
  label?: string;
  /** First photograph is the LCP image when the gallery opens the page. */
  eagerFirst?: boolean;
}

const {
  items,
  label = 'Build photographs and films — photographs open full screen, films play here',
  eagerFirst = false
} = Astro.props;

const isFilm = (item: GalleryItem): item is FilmData => 'provider' in item;

/**
 * Bands of three columns: an upright tile takes one, a wide tile two, a full
 * tile the whole row, and a pair of `half` shots splits one column as a stack.
 */
type Band =
  | { kind: 'tile'; item: GalleryItem }
  | { kind: 'stack'; items: GalleryItem[] };

const bands: Band[] = [];
for (const item of items) {
  const open = bands.at(-1);
  if (item.layout === 'half' && open?.kind === 'stack' && open.items.length < 2) {
    open.items.push(item);
  } else if (item.layout === 'half') {
    bands.push({ kind: 'stack', items: [item] });
  } else {
    bands.push({ kind: 'tile', item });
  }
}
---

<section class="gallery" data-gallery aria-label={label}>
  {
    bands.map((band, i) => {
      if (band.kind === 'stack') {
        return (
          <div class="gallery__stack">
            {band.items.map((item, n) => {
              const eager = eagerFirst && i === 0 && n === 0 && !isFilm(item);
              return isFilm(item) ? (
                <Video
                  provider={item.provider}
                  id={item.id}
                  title={item.title}
                  variant={item.layout ?? 'full'}
                />
              ) : (
                <Shot {...item} variant={item.layout ?? 'tall'} eager={eager} />
              );
            })}
          </div>
        );
      }

      const eager = eagerFirst && i === 0 && !isFilm(band.item);
      return isFilm(band.item) ? (
        <Video
          provider={band.item.provider}
          id={band.item.id}
          title={band.item.title}
          variant={band.item.layout ?? 'full'}
        />
      ) : (
        <Shot {...band.item} variant={band.item.layout ?? 'tall'} eager={eager} />
      );
    })
  }
</section>
